import { ScriptsList } from "../components/support_page/scripts_list.slint";
import { ScriptDetails } from "../components/support_page/script_details.slint";
import {
    PseudoConcosole,
} from "../components/support_page/pseudo_console.slint";
import { PagesHeader } from "../components/shared/pages_header.slint";
export component SupportPage {

    // Temp properties for testing
    // TO-DO: Change to parent.width and parent.height
    width: 1100px;
    height: 720px;

    in-out property <{
        name: string,
        description: string,
        name_short: string,
        description_long: string,
        img_url: image
    }> selected_script;
    in-out property <string> console_output;

    callback handle_script_module_select(string, string, string, image);
    callback handle_script_execution();
    callback navigate_to(string);

    VerticalLayout {

        PagesHeader {
            header_text: "Suporte Técnico";
            navigate_to(page) => {
                root.navigate_to(page)
            }
        }

        HorizontalLayout {
            height: parent.height * 0.30;
            alignment: center;
            padding-top: 24px;
            padding-bottom: 24px;

            ScriptsList {
                height: parent.height * 0.85;
                width: parent.width * 0.85;

                handle_script_module_select(name, description, description_long, img_url) => {
                    root.handle_script_module_select(name, description, description_long, img_url);
                }
                handle_script_execution => {
                    root.handle_script_execution();
                }
            }
        }

        HorizontalLayout {
            width: root.width;
            padding-top: 86px;
            padding: 20px;
            spacing: 20px;

            ScriptDetails {
                selected_script: root.selected_script;

                width: root.width * 0.45;
                height: root.height * 0.40;
            }

            PseudoConcosole {
                console_output: root.console_output;

                width: root.width * 0.50;
                height: root.height * 0.40;
            }
        }
    }
}

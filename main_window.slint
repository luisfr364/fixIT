
import { WelcomePage } from "./pages/welcome_page.slint";
import { SupportPage } from "pages/support_page.slint";
import { MonitoringPage } from "pages/monitoring_page.slint";


export component MainWindow inherits Window {
    width: 1100px;
    height: 720px;
    background: #0B1220;
    title: "fixIT - Dashboard";

    // Callbacks used by components *they need to be centralized here*
    callback navigate_to(string);
    callback handle_script_module_select(string, string, string, image);
    callback handle_script_execution();

    // Property used to control which page is currently being displayed in the MainWindow
    in-out property <string> current_page: "welcome";

    // Properties used by other components
    // These are updated by the controller of each component
    in-out property <int> memory_usage: 0;
    in-out property <int> cpu_usage: 0;
    in-out property <int> disk_usage: 0;
    in-out property <bool> is_connected: false;
    in-out property <{ os: string, cpu_name: string}> system_info;
    in-out property <{ cpu_name: string, cpu_core_count: string, cpu_thread_count: string}> cpu_info;

    //Support page propertiess
    in-out property <string> console_output: "Nenhuma saída ainda...";
    in-out property <{
        name: string,
        description: string,
        name_short: string,
        description_long: string,
        img_url: image
    }> selected_script: { name: "", description: "", name_short: "", description_long: "", img_url: @image-url("") };

    if (root.current_page == "welcome"): WelcomePage {
        width: parent.width;
        height: parent.height;

        cpu_usage: root.cpu_usage;
        memory_usage: root.memory_usage;
        disk_usage: root.disk_usage;
        is_connected: root.is_connected;
        system_info: root.system_info;

        navigate_to(page) => {
            root.navigate_to(page);
        }
    }

    if (root.current_page == "support"): SupportPage {
        width: parent.width;
        height: parent.height;

        console_output: root.console_output;
        selected_script: root.selected_script;

        handle_script_module_select(name, description, description_long, img_url) => {
            root.handle_script_module_select(name, description, description_long, img_url);
        }
        handle_script_execution => {
            root.handle_script_execution()
        }
        navigate_to(page) => {
            root.navigate_to(page);
        }

        // TO-DO: Implement later
        // navigate_back() => { root.current_page = "welcome"; }
    }

    if (root.current_page == "monitoring"): MonitoringPage {
        width: parent.width;
        height: parent.height;

        disk_usage: root.disk_usage;

        navigate_to(page) => {
            root.navigate_to(page)
        }
    }
}
